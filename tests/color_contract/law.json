{
  "loop": {
    "build": ["/usr/bin/python3 -I -B tests/color_contract/run.py build"],
    "verify": ["/usr/bin/python3 -I -B tests/color_contract/test_driver.py"],
    "test": ["/usr/bin/python3 -I -B tests/color_contract/run.py test all"],
    "test_one": "/usr/bin/python3 -I -B tests/color_contract/run.py test {test}",
    "tasks": "tests/color_contract/tasks",
    "review": ".law/color-contract-review.json",
    "inputs": ["tests/color_contract/fixtures/**", "tests/color_contract/law.json"],
    "timeout": 360
  }
}
