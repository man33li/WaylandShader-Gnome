{
  "tests": ["verify.py"],
  "loop": {
    "build": ["/usr/bin/python3 -I -B verify.py build"],
    "verify": ["/usr/bin/python3 -I -B verify.py verify"],
    "test": ["/usr/bin/python3 -I -B verify.py test all"],
    "test_one": "/usr/bin/python3 -I -B verify.py test {test}",
    "inputs": ["verification-inputs-v2.json"],
    "timeout": 1100
  }
}
